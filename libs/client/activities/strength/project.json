{
  "name": "strength",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/client/activities/strength/src",
  "prefix": "strength",
  "projectType": "library",
  "tags": ["type:feature"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/client/activities/strength/jest.config.cts",
        "tsConfig": "libs/client/activities/strength/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4401,
        "configDir": "libs/client/activities/strength/.storybook",
        "browserTarget": "strength:build-storybook",
        "compodoc": false,
        "stylePreprocessorOptions": {
          "includePaths": ["libs/ui/src/styles"]
        },
        "styles": ["libs/ui/src/styles/index.scss"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/strength",
        "configDir": "libs/client/activities/strength/.storybook",
        "browserTarget": "strength:build-storybook",
        "compodoc": false,
        "styles": ["libs/ui/src/styles/index.scss"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c libs/client/activities/strength/.storybook --url=http://localhost:4401"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "strength:build-storybook",
        "staticFilePath": "dist/storybook/strength",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "strength:build-storybook:ci"
        }
      }
    }
  }
}
